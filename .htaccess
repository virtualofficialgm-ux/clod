# Служебные файлы репозитория не должны открываться в браузере
RedirectMatch 404 /\.git
RedirectMatch 404 /\.github
RedirectMatch 404 /deploy\.sh

# Страницы, скрипты, стили, настройки админки и контент всегда проверяются на свежесть
<IfModule mod_headers.c>
  <FilesMatch "(config\.yml|\.json|\.html|\.js|\.css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
