# Адрес веб-версии: ссылки «Поделиться» и возврат из оплаты
EXPO_PUBLIC_SITE_URL=http://localhost:3000
# Только для сервера (Edge Functions, сиды). Никогда не отдавать клиенту.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (тестовый режим). Секреты — только в секретах Edge Functions:
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_... STRIPE_WEBHOOK_SECRET=whsec_...
# Вебхук в панели Stripe: <SUPABASE_URL>/functions/v1/stripe-webhook, события:
#   checkout.session.*, customer.subscription.*, invoice.paid, account.updated, transfer.reversed, charge.refunded
# Цены Pro ($15/мес, $144/год) создаются прямо в Checkout — отдельные Price ID не нужны.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# --- USDT через NOWPayments (секреты Edge Functions) ---
# IPN: <SUPABASE_URL>/functions/v1/crypto-webhook
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# --- Claude API (только сервер) ---
ANTHROPIC_API_KEY=

# --- Сайт ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
